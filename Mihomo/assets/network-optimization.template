#!/bin/sh

# 跳过回环接口
if [ "${IFACE}" = "lo" ]; then
    exit 0
fi

# 等待接口出现在 sysfs（最多 2 秒）。if-up 时接口通常已就绪，直接继续，
# 避免固定 sleep 2 在多网卡场景逐个累加阻塞
waited=0
while [ "${waited}" -lt 2 ] && [ ! -d "/sys/class/net/${IFACE}" ]; do
    sleep 1
    waited=$((waited + 1))
done

# 检查接口是否存在
if [ -d "/sys/class/net/${IFACE}" ]; then

    # 1. 增大发送队列长度 (txqueuelen)
    # 对于高带宽（如 2.5G/10G）环境，5000 是个很稳健的取值
    ip link set "${IFACE}" txqueuelen 5000 2>/dev/null || true

    # 2. 启用硬件/软件卸载功能 (Offloading)
    # 在 PVE VirtIO 环境下，这些选项能显著降低 CPU 占用并提升吞吐。
    # 不含 lro：LRO 会不可逆地合并/改写报文头部，在开启 IP 转发的路由器上
    # 必须关闭（内核也会在开启转发时自动关掉它）；GRO 对转发安全，保留。
    for opt in rx tx sg tso gso gro; do
        ethtool -K "${IFACE}" "$opt" on 2>/dev/null || true
    done

    # 3. 针对 VirtIO 的特殊优化：结合多队列
    ethtool -L "${IFACE}" combined "$(nproc)" 2>/dev/null || true

    echo "Optimization applied to ${IFACE}: txqueuelen=5000, offloading=on(no LRO), multi-queue=auto"
fi
