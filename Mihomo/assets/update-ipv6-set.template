#!/bin/sh
set -e

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

# 与主安装脚本一致：优先取默认路由所在网卡，再退回「第一个非虚拟网卡」
PRIMARY_IFACE=$(ip -o -4 route show default 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "dev") print $(i+1)}' | head -n 1)
if [ -z "${PRIMARY_IFACE}" ]; then
    PRIMARY_IFACE=$(ip -o -6 route show default 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "dev") print $(i+1)}' | head -n 1)
fi
if [ -z "${PRIMARY_IFACE}" ]; then
    PRIMARY_IFACE=$(ip -o link show | awk -F': ' '{print $2}' | grep -v '^lo$' \
        | grep -vE '^(tun|tap|veth|docker|br-|virbr|wg|ppp)' | head -n 1)
fi
if [ -z "${PRIMARY_IFACE}" ]; then
    log "错误: 无法检测到网卡"
    exit 1
fi

if ! nft list set inet filter local_ipv6_list > /dev/null 2>&1; then
    log "错误: 没找到 local_ipv6_list 集合（nftables 规则是否已加载？）"
    exit 1
fi

SET_LIST=$(nft list set inet filter local_ipv6_list 2>/dev/null)

# 提取所有以 2 开头的 IPv6 直连前缀（公网段），逐个维护
NETWORKS=$(ip -6 route show dev "${PRIMARY_IFACE}" \
| awk '$1 ~ /^2/ {print $1}' \
| awk -F/ '{
    if (NF == 2 && $2 + 0 > 60) {
      split($1, g, ":")
      if (g[4] == "") {
        print $1 "/60"
      } else {
        g[4] = substr(g[4], 1, length(g[4]) - 1) "0"
        printf "%s:%s:%s:%s::/60\n", g[1], g[2], g[3], g[4]
      }
    } else {
      print $0
    }
  }' \
| sort -u)
if [ -z "${NETWORKS}" ]; then
    log "未找到以 2 开头的 IPv6 直连网段"
    exit 0
fi

# mihomo 自动探测只把单个 /64（如 ...:db91::/64）写进 inet mihomo 的
# inet6_local_address_set，而它的 DNS 劫持规则是
# 「ip6 saddr @inet6_local_address_set th dport 53 dnat ...」——只认集合里的元素。
# /60 委派下若还有别的 /64 子网，其客户端 DNS 就匹配不到、劫持失效。
# 下面在同一段里把该集合内「属于本 /60、掩码长于 /60」的公网元素归一到 /60。
# mihomo 重载时会重新写回自己的 /64，本脚本每 15 分钟再归一一次即可。
MIHOMO_SET_LIST=""
if nft list set inet mihomo inet6_local_address_set > /dev/null 2>&1; then
    MIHOMO_SET_LIST=$(nft list set inet mihomo inet6_local_address_set 2>/dev/null)
fi

for NETWORK in ${NETWORKS}; do
    # nft 的 list set 可能把所有元素排在同一行，用 grep 取整行会拿到别的
    # 网段的 expires；这里按「该网段之后、下一个逗号或右花括号之前」精确截取
    ELEMENT_INFO=$(echo "${SET_LIST}" | tr '\n' ' ' | \
        sed -n "s|.*${NETWORK}\([^,}]*\).*|\1|p")

    if [ -n "${ELEMENT_INFO}" ]; then
        # nft 的剩余时间格式不固定：23h59m58s / 1d2h / 45m / 30s 都要认，
        # 统一换算成秒再判断，避免旧版只认三段格式导致「45m」被误判为充足
        EXPIRES_STR=$(echo "${ELEMENT_INFO}" | grep -oE 'expires [0-9dhms]+' | head -n 1 | cut -d' ' -f2)
        DAYS=$(echo "${EXPIRES_STR}" | grep -oE '[0-9]+d' | tr -d 'd')
        HOURS=$(echo "${EXPIRES_STR}" | grep -oE '[0-9]+h' | tr -d 'h')
        MINS=$(echo "${EXPIRES_STR}" | grep -oE '[0-9]+m' | tr -d 'm')
        SECS=$(echo "${EXPIRES_STR}" | grep -oE '[0-9]+s' | tr -d 's')
        REMAINING=$(( ${DAYS:-0} * 86400 + ${HOURS:-0} * 3600 + ${MINS:-0} * 60 + ${SECS:-0} ))

        if [ "${REMAINING}" -ge 7200 ]; then
            log "网段 ${NETWORK} 已存在，剩余 ${EXPIRES_STR}（>= 2h），跳过"
            continue
        fi
        log "网段 ${NETWORK} 剩余时间不足 2 小时（${EXPIRES_STR:-无法解析}），刷新超时..."
        nft "delete element inet filter local_ipv6_list { ${NETWORK} }" 2>/dev/null || true
    fi

    log "添加 IPv6 网段: ${NETWORK}"
    nft "add element inet filter local_ipv6_list { ${NETWORK} timeout 24h }"
done

# —— mihomo 集合同步（独立循环，不受上面 local_ipv6_list 剩余时间的 continue 影响）——
# mihomo 只把单个 /64（...:db91::/64）写进 inet mihomo inet6_local_address_set，
# 而它的 DNS 劫持规则「ip6 saddr @inet6_local_address_set th dport 53 dnat ...」只认集合元素，
# 同一 /60 委派下别的 /64 子网就劫持不到。这里把该集合里「归一后等于上面某个 /60」的长掩码元素换成 /60。
if [ -n "${MIHOMO_SET_LIST}" ]; then
    # 取形如 2408:8210:6027:db91::/64 的「前 4 段非空 + 掩码长于 /60」元素：
    # 排除 fd00:1::/64（第 4 段为 1，但它是 ULA，靠下面与 NETWORKS 的 /60 归一比对来排除）；
    # ULA 网段绝不会出现在 NETWORKS（只取以 2 开头的公网前缀），归一比对天然过滤掉它们。
    LONG_ELEMS=$(echo "${MIHOMO_SET_LIST}" | \
        grep -oE '[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+::/[0-9]+' | \
        awk -F/ '{ if ($2 + 0 > 60) print $1 "/" $2 }')
    for ELEM in ${LONG_ELEMS}; do
        # 与上面 /64→/60 同一套归一：清零第 4 段末位十六进制，得到该元素所属的 /60
        ELEM60=$(echo "${ELEM}" | awk -F/ '{
            split($1, g, ":")
            if (g[4] != "") { g[4] = substr(g[4], 1, length(g[4]) - 1) "0" }
            printf "%s:%s:%s:%s::/60\n", g[1], g[2], g[3], g[4]
        }')
        # 只归一属于本机直连公网 /60 的元素；fd00:1::/64 之类归一后不在 NETWORKS，跳过
        case " ${NETWORKS} " in
            *" ${ELEM60} "*)
                nft "delete element inet mihomo inet6_local_address_set { ${ELEM} }" 2>/dev/null || true
                if echo "${MIHOMO_SET_LIST}" | grep -qF "${ELEM60}"; then
                    log "mihomo 集合：删除长掩码 ${ELEM}，${ELEM60} 已存在"
                else
                    log "mihomo 集合：${ELEM} 归一到 ${ELEM60}"
                    nft "add element inet mihomo inet6_local_address_set { ${ELEM60} }" 2>/dev/null || true
                fi
                ;;
        esac
    done
fi

exit 0
